{
  "permissions": {
    "deny": [
      "mcp__claudeleaf__overleaf_set_document",
      "mcp__claudeleaf__overleaf_delete_document",
      "mcp__claudeleaf__overleaf_delete_range",
      "mcp__claudeleaf__overleaf_delete_lines",
      "mcp__claudeleaf__overleaf_rename_document"
